// This is your Prisma schema file for the Plan Builder OQF feature

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model (simplified - integrate with your existing user system)
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  plans         Plan[]
  planDrafts    PlanDraft[]
  analytics     AnalyticsEvent[]
  completions   PlanCompletion[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// Plan Draft - stores in-progress plan builder state
model PlanDraft {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  answers          Json           // Stores all answers as JSON
  currentStep      String
  state            Json           // Full flow state
  status           DraftStatus    @default(IN_PROGRESS)
  completedPlanId  String?
  completedPlan    Plan?          @relation(fields: [completedPlanId], references: [id])
  stepLogs         PlanStepLog[]
  createdAt        DateTime       @default(now())
  lastUpdatedAt    DateTime       @updatedAt
  completedAt      DateTime?
  abandonedAt      DateTime?

  @@index([userId, status])
  @@index([createdAt])
}

enum DraftStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// Plan Step Log - tracks individual step completions
model PlanStepLog {
  id          String    @id @default(cuid())
  draftId     String
  draft       PlanDraft @relation(fields: [draftId], references: [id])
  userId      String
  stepId      String
  answer      String    // JSON string of the answer
  timestamp   DateTime
  
  @@index([draftId])
  @@index([userId, stepId])
}

// Generated Plan
model Plan {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  name         String
  description  String?
  config       Json       // Original configuration used to generate
  workouts     Json       // Array of workout objects
  schedule     Json       // Schedule details
  metadata     Json?      // Additional metadata
  isActive     Boolean    @default(true)
  drafts       PlanDraft[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  @@index([userId, isActive])
  @@index([createdAt])
}

// Analytics Event
model AnalyticsEvent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  event       String
  sessionId   String?
  properties  Json
  createdAt   DateTime  @default(now())
  
  @@index([event])
  @@index([userId, event])
  @@index([sessionId])
  @@index([createdAt])
}

// Funnel Metrics - aggregated per step
model FunnelMetric {
  id           String    @id @default(cuid())
  stepId       String
  variant      String
  date         DateTime
  views        Int       @default(0)
  completions  Int       @default(0)
  abandonments Int       @default(0)
  avgTimeSpent Float?    // Average time spent on this step
  
  @@unique([stepId, variant, date])
  @@index([date])
  @@index([variant])
}

// Daily Metrics - overall metrics
model DailyMetric {
  id            String    @id @default(cuid())
  date          DateTime
  variant       String
  completions   Int       @default(0)
  abandonments  Int       @default(0)
  totalDuration Int       @default(0) // Total time in milliseconds
  
  @@unique([date, variant])
  @@index([date])
}

// Plan Completion Record
model PlanCompletion {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  planId      String?
  totalSteps  Int
  duration    Int       // Time in milliseconds
  variant     String
  completedAt DateTime
  
  @@index([userId])
  @@index([completedAt])
  @@index([variant])
}





